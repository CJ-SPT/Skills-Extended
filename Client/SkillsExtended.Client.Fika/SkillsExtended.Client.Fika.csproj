<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SkillsExtendedFika</AssemblyName>
    <Version>1.2.2</Version>
    <Nullable>enable</Nullable>
    <RootNamespace>SkillsExtendedFika</RootNamespace>
    <FikaAssemblyPath Condition="'$(FikaAssemblyPath)' == ''">$(TarkovPluginsDir)Fika\Fika.Core.dll</FikaAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SkillsExtended.Common\SkillsExtended.Common.csproj" />
    <ProjectReference Include="..\SkillsExtended.Client.Skills\SkillsExtended.Client.Skills.csproj" />
    <Reference Include="Fika.Core" HintPath="$(FikaAssemblyPath)" Private="false" />
  </ItemGroup>

  <Target Name="CheckFikaReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(FikaAssemblyPath)')" Text="Fika.Core.dll was not found. Set FikaAssemblyPath to a compatible Fika reference DLL, or build the core client/server projects separately." />
  </Target>

  <Target Name="DeploySkillsExtendedFika" AfterTargets="PostBuildEvent"
          Condition="'$(DeploySkillsExtended)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SkillsExtendedClientDeployDir)" SkipUnchangedFiles="true" Condition="Exists('$(TarkovPluginsDir)Fika\Fika.Core.dll')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SkillsExtendedHeadlessClientDeployDir)" SkipUnchangedFiles="true" Condition="Exists('$(TarkovHeadlessDir)\BepInEx\plugins\Fika\Fika.Core.dll')" />
  </Target>
</Project>
