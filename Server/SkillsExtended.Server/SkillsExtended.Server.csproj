<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>3.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SkillsExtended.ServerMod</AssemblyName>
    <RootNamespace>SkillsExtended</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0-pre.202607161908" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0-pre.202607161908" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.0-pre.202607161908" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SkillsExtended.Common\SkillsExtended.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TarkovDir Condition=" '$(TarkovDir)' == '' ">$(SolutionDir)..\..\</TarkovDir>
    <SptModDir>$(TarkovDir)SPT_Runtime\user\mods\</SptModDir>
  </PropertyGroup>

  <Target Name="CopyToServer" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <OutputDLL Include="$(ProjectDir)$(OutDir)$(TargetName).dll" />
      <CommonDLL Include="$(ProjectDir)$(OutDir)SkillsExtended.Common.dll" />
      <Resources Include="$(ProjectDir)Resources\**\*.*" />
      <WebAssets Include="$(ProjectDir)wwwroot\**\*.*" />
      <Bundles Include="$(ProjectDir)Bundles\**\*.*" />
      <BundlesJson Include="$(ProjectDir)bundles.json" />
    </ItemGroup>

    <!-- Copies the output dll -->
    <Copy
      SourceFiles="@(OutputDLL);@(CommonDLL);"
      DestinationFolder="$(SptModDir)\SkillsExtended"
    />

    <!-- Copies the resources -->
    <Copy
      SourceFiles="@(Resources);"
      DestinationFolder="$(SptModDir)\SkillsExtended\Resources\%(RecursiveDir)"
    />

    <!-- Copy the wwwroot folder -->
    <Copy
      SourceFiles="@(WebAssets)"
      DestinationFolder="$(SptModDir)\SkillsExtended\wwwroot\%(RecursiveDir)"
    />

    <!-- Copy bundles -->
    <Copy
      SourceFiles="@(bundles)"
      DestinationFolder="$(SptModDir)\SkillsExtended\bundles\%(RecursiveDir)"
    />

    <!-- Copy bundles.json -->
    <Copy SourceFiles="@(BundlesJson)" DestinationFolder="$(SptModDir)\SkillsExtended" />
  </Target>
</Project>
