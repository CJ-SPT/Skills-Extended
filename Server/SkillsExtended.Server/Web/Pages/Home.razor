@page "/skills-extended"
@layout BaseLayout
@inject IServiceProvider Services

<PageTitle>Configuration · Skills Extended</PageTitle>

<header class="se-page-heading">
    <div>
        <p class="se-eyebrow">Skills Extended</p>
        <h1>Make every skill your own</h1>
        <p>Configure progression and bonuses. Changes stay in your draft until you save.</p>
    </div>
</header>

<section class="se-panel se-overview">
    <div>
        <strong>@SkillCatalog.All.Count skills</strong>
        <p>@EnabledCount enabled · @Session.ChangeCount pending changes</p>
    </div>
    <label class="se-toggle">
        <input type="checkbox"
               checked="@Session.Server.CheckForUpdates"
               @onchange="ToggleUpdates" />
        <span>
            <strong>Check for updates</strong>
            <small>Takes effect on the next server startup. Game settings require a client restart after saving.</small>
        </span>
    </label>
</section>

<ClientEditorAccess Profiles="@_profiles" />

@if (Session.Server.CheckForUpdates && Updates?.UpdateAvailable == true && Updates.ReleaseInformation is { } release)
{
    <p class="se-notice">
        Version @release.Version is available.
        <a href="@release.DownloadUrl">View release</a>
    </p>
}

@foreach (var category in SkillCatalog.All.GroupBy(s => s.Category))
{
    <h2 class="se-category-heading">@category.Key</h2>
    <div class="se-card-grid">
        @foreach (var skill in category)
        {
            <a class="se-skill-card" href="@skill.Url">
                <img src="@($"/skills-extended/icons/{skill.Icon}.png")"
                     alt=""
                     width="40"
                     height="40" />
                <div>
                    <h3>@skill.Name</h3>
                    <p>@skill.Description</p>
                    <span class="se-badge">@(IsEnabled(skill) ? "Enabled" : "Disabled")</span>
                    @if (Session.ChangesFor(skill.Key) > 0)
                    {
                        <span class="se-badge se-pending">@Session.ChangesFor(skill.Key) pending</span>
                    }
                </div>
            </a>
        }
    </div>
}

<section class="se-panel se-links">
    <a href="/skills-extended/guides">Read mini-game guides</a>
    <a href="/skills-extended/skill-level-changer">Edit profile skill levels</a>
    <a href="/skills-extended/release-notes">Read release notes</a>
</section>

@code
{
    private UpdateChecker? Updates => Services.GetService<UpdateChecker>();
    private IReadOnlyList<ProfileChoice> _profiles = [];

    protected override void OnInitialized() =>
        _profiles = Services.GetService<SkillLevelAdjuster>()?.GetProfiles() ?? [];

    [CascadingParameter]
    public EditorSession Session { get; set; } = null!;

    private bool IsEnabled(SkillDefinition skill) =>
        (bool)
            skill
                .Data(Session.Skills)
                .GetType()
                .GetProperty("Enabled")!
                .GetValue(skill.Data(Session.Skills))!;

    private int EnabledCount => SkillCatalog.All.Count(IsEnabled);

    private void ToggleUpdates(ChangeEventArgs e)
    {
        Session.Server.CheckForUpdates = e.Value is true;
        Session.Notify();
    }
}
