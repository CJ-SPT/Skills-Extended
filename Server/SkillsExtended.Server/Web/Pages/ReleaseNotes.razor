@page "/skills-extended/release-notes"
@using SPTarkov.Server.Core.Utils
@layout BaseLayout

@inject FileUtil FileUtil
@inject JsonUtil JsonUtil

<PageTitle>Release notes · Skills Extended</PageTitle>
<ReleaseNotesContent Notes="_releaseNotes" LoadError="@_loadError" />

@code
{
    private string? _loadError;
    private List<ReleaseNote> _releaseNotes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var path = Path.Combine(ModMetadata.ResourcesDirectory, "ReleaseNotes.json");
            var text = await FileUtil.ReadFileAsync(path);
            _releaseNotes = JsonUtil.Deserialize<List<ReleaseNote>>(text) ?? [];
        }
        catch
        {
            _loadError = "Release notes could not be loaded. Configuration editing is still available.";
        }
    }
}
