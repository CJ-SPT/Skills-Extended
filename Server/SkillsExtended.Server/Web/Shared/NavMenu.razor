<nav aria-label="Skills Extended navigation">
    <label class="se-field se-nav-search">
        Find a skill
        <input type="search"
               placeholder="Search skills…"
               @bind="_search"
               @bind:event="oninput" />
    </label>

    <NavLink href="/skills-extended"
             Match="NavLinkMatch.All"
             class="se-nav-link"
             @onclick="Navigate">
        Overview
    </NavLink>
    <NavLink href="/skills-extended/guides" class="se-nav-link" @onclick="Navigate">
        Mini-game guides
    </NavLink>
    <NavLink href="/skills-extended/leveling-speed" class="se-nav-link" @onclick="Navigate">
        Leveling speed
        @if (Session.ChangesFor("LevelingSpeed") > 0) { <span class="se-pending-dot" aria-label="Unsaved changes">●</span> }
    </NavLink>
    <NavLink href="/skills-extended/skill-level-changer"
             class="se-nav-link"
             @onclick="Navigate">
        Profile skill levels
    </NavLink>

    @foreach (var category in SkillCatalog.Navigation.GroupBy(s => s.Category))
    {
        <p class="se-nav-category">@category.Key</p>
        @foreach (var skill in category.Where(s => s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        {
            <NavLink href="@skill.Url" class="se-nav-link" @onclick="Navigate">
                <img src="@($"/skills-extended/icons/{skill.Icon}.png")"
                     alt=""
                     width="24"
                     height="24" />
                <span>@skill.Name</span>
                @if (Session.PageChangesFor(skill.Key) > 0)
                {
                    <span class="se-pending-dot" aria-label="Unsaved changes">●</span>
                }
            </NavLink>
        }
    }

    @if (!SkillCatalog.Navigation.Any(s => s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))
    {
        <p class="se-empty">No skills match.</p>
    }

    <NavLink href="/skills-extended/release-notes" class="se-nav-link" @onclick="Navigate">
        Release notes
    </NavLink>
</nav>

@code
{
    [CascadingParameter]
    public EditorSession Session { get; set; } = null!;

    [Parameter]
    public EventCallback Navigate { get; set; }
    private string _search = "";
}
